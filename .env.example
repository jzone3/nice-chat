# Get a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
# Optional
PORT=3000
JEV_MODEL=jev-latest
DATA_FILE=./data/state.json
MAX_MESSAGES=500
# Abuse guards: max message length and room-wide Jev calls per day (UTC).
# 6.25M calls ≈ $500/day; past JEV_PREVIEW_SHARE of it the as-you-type preview pauses, sends keep working.
MAX_TEXT=280
JEV_BUDGET_DAY=6250000
JEV_PREVIEW_SHARE=0.8

# Resident personas (bots.js) and the online-count floor. BOTS=0 / ONLINE_FLOOR=0 turn them off.
# BOTS=1
# BOT_EVERY_MS=60000
# ONLINE_FLOOR=50

# Shared store for multi-instance / serverless deployments (Vercel Upstash sets this for you).
# REDIS_URL=rediss://default:password@host:6379
# Realtime transport: sse (default for a long-running server) or poll (default on Vercel).
# TRANSPORT=poll
# POLL_MS=2500
